# AI & Agent Framework Configuration
# LLM_PROVIDER options: bedrock | gemini | ollama (default: gemini)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# AWS Bedrock / Strands Agent Configuration (Optional if using Bedrock)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Commerce & Delivery Integration
# COMMERCE_MODE options: live (Swiggy Instamart MCP) | mock (Deterministic Mock)
COMMERCE_MODE=live
SWIGGY_MCP_URL=https://mcp.swiggy.com/im
SWIGGY_CLIENT_ID=swiggy-mcp
SWIGGY_REDIRECT_URI=http://localhost:8000/api/auth/swiggy/callback
# Optional pre-seeded Bearer Token (if bypassing browser OAuth flow)
# SWIGGY_ACCESS_TOKEN=your_swiggy_token_here

# Autonomy & Household Rules
# DEFAULT_AUTONOMY_PROFILE options: FULL_AUTOPILOT | ASK_EVERYTHING | RESTRICTIVE
DEFAULT_AUTONOMY_PROFILE=FULL_AUTOPILOT

# Server & Runtime
PORT=8000
IMAGE_MATCH_THRESHOLD=0.90
